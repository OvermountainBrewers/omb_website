{
  "name": "website",
  "version": "2",
  "private": true,
  "scripts": {
    "load-env": "env-cmd -f ../.env.local",
    "dev": "NODE_OPTIONS='--inspect' yarn load-env next",
    "build": "yarn load-env next build",
    "build:ci": "next build",
    "start": "yarn load-env next start",
    "lint": "eslint .",
    "now-build": "next build",
    "prettify": "prettier --write \"**/*.{ts,tsx,json}\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "~1.2.0",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "~2.1.16",
    "@radix-ui/react-navigation-menu": "~1.3.0",
    "@radix-ui/react-select": "~2.3.8",
    "@radix-ui/react-slot": "~1.4.0",
    "@radix-ui/react-toggle-group": "~1.1.20",
    "@sanity/client": "^8.9.0",
    "@sanity/image-url": "^2.1.1",
    "@sanity/types": "^6.18.0",
    "@tailwindcss/typography": "^0.5.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "env-cmd": "^11.0.0",
    "lucide-react": "^1.55.0",
    "next": "^16.4.0",
    "next-sanity": "^13.3.4",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "resend": "^6.32.1",
    "sanity": "^6.18.0",
    "styled-components": "^6.5.3",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10",
    "eslint-config-next": "^16.4.0",
    "eslint-config-prettier": "^10.1.8",
    "postcss": "^8.5.29",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3"
  },
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/next"
    }
  ],
  "engines": {
    "node": "24.x"
  }
}
