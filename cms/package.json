{
  "name": "overmountainbrewers",
  "private": true,
  "version": "1.0.0",
  "main": "package.json",
  "license": "UNLICENSED",
  "scripts": {
    "load-env": "env-cmd -f ../.env.local",
    "dev": "yarn load-env sanity dev",
    "start": "yarn load-env sanity start",
    "build": "yarn load-env sanity build",
    "undeploy": "yarn load-env sanity undeploy",
    "deploy": "yarn load-env sanity deploy",
    "deploy-graphql": "yarn load-env sanity graphql deploy",
    "prettify": "prettier --write \"**/*.{ts,tsx,json}\"",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "sanity"
  ],
  "dependencies": {
    "@sanity/icons": "^5.2.3",
    "@sanity/ui": "^4.4.0",
    "@sanity/vision": "^6.18.0",
    "date-fns": "^4.4.0",
    "env-cmd": "^11.0.0",
    "pluralize": "^8.0.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "sanity": "^6.18.0",
    "styled-components": "^6.5.3"
  },
  "devDependencies": {
    "@sanity/eslint-config-studio": "^7.0.0",
    "@types/node": "^24",
    "@types/pluralize": "^0.0.33",
    "@types/react": "^19",
    "eslint": "^10",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3"
  },
  "prettier": {
    "semi": false,
    "printWidth": 100,
    "bracketSpacing": false,
    "singleQuote": true
  },
  "engines": {
    "node": "24.x"
  }
}
